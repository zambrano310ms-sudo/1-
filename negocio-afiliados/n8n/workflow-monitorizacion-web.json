{
  "name": "Afiliados · Monitorización web + alerta",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 30 }
          ]
        }
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "url": "https://TU-DOMINIO.es/",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "GET sitio web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "¿Está caída?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID_TELEGRAM",
        "text": "=⚠️ La web de afiliados NO responde correctamente.\nCódigo: {{ $json.statusCode }}\nHora: {{ $now.format('dd/MM/yyyy HH:mm') }}\nRevisa el hosting.",
        "additionalFields": {}
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Alerta Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [940, 220],
      "credentials": {
        "telegramApi": { "id": "REEMPLAZAR", "name": "Telegram bot afiliados" }
      }
    },
    {
      "parameters": {},
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Todo OK (no hacer nada)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 400]
    }
  ],
  "connections": {
    "Cada 30 min": { "main": [[{ "node": "GET sitio web", "type": "main", "index": 0 }]] },
    "GET sitio web": { "main": [[{ "node": "¿Está caída?", "type": "main", "index": 0 }]] },
    "¿Está caída?": {
      "main": [
        [{ "node": "Alerta Telegram", "type": "main", "index": 0 }],
        [{ "node": "Todo OK (no hacer nada)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
